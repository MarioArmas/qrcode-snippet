<Window x:Class="QrSnippet.Views.ScreenCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select an area"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True">

    <Grid>

        <!-- Frozen screenshot of this monitor -->
        <Image x:Name="ScreenImage"
               Stretch="Fill" />

        <Canvas>

            <!-- Dims everything except the selection (geometry is set in code-behind) -->
            <Path x:Name="DimLayer"
                  Fill="#80000000" />

            <Rectangle x:Name="SelectionBorder"
                       Stroke="White"
                       StrokeThickness="1"
                       Visibility="Collapsed" />

        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="14,8"
                CornerRadius="6"
                Background="#CC000000"
                IsHitTestVisible="False">

            <TextBlock Text="Drag to select the QR code · Esc to cancel"
                       Foreground="White"
                       FontSize="14" />

        </Border>

    </Grid>

</Window>
