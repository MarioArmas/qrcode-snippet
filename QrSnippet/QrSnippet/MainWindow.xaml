<Window x:Class="QrSnippet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QrSnippet.Models"
        xmlns:converters="clr-namespace:QrSnippet.Converters"
        Title="QR Reader"
        Width="640"
        Height="600"
        MinWidth="500"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

    <Window.InputBindings>
        <KeyBinding Key="V"
                    Modifiers="Control"
                    Command="{Binding PasteImageCommand}" />
        <KeyBinding Key="O"
                    Modifiers="Control"
                    Command="{Binding OpenImageCommand}" />
        <KeyBinding Key="S"
                    Modifiers="Control+Shift"
                    Command="{Binding CaptureCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <converters:NullToVisibilityConverter x:Key="VisibleWhenSet" />
        <converters:NullToVisibilityConverter x:Key="VisibleWhenNull"
                                              Invert="True" />
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <!-- Segoe Fluent Icons glyph -->
        <Style x:Key="IconStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth"
                    Value="150" />
            <Setter Property="Padding"
                    Value="16,10" />
            <Setter Property="Margin"
                    Value="4,0" />
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview / drop zone -->
        <Grid Grid.Row="0">

            <Rectangle RadiusX="8"
                       RadiusY="8"
                       Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                       Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                       StrokeThickness="1.5"
                       StrokeDashArray="4 3" />

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding PreviewImage, Converter={StaticResource VisibleWhenNull}}">

                <TextBlock Text="&#xED14;"
                           Style="{StaticResource IconStyle}"
                           FontSize="56"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBlock Text="Drop an image with a QR code here"
                           Margin="0,16,0,4"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="or paste it, open a file, or capture part of your screen"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            </StackPanel>

            <!-- Last scanned image -->
            <Image Source="{Binding PreviewImage}"
                   Margin="16"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Shown while a file is dragged over the window -->
            <Border x:Name="DropHint"
                    CornerRadius="8"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="&#xE896;"
                               Style="{StaticResource IconStyle}"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                    <TextBlock Text="Drop to scan"
                               Margin="0,12,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16">

            <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding PasteImageCommand}"
                    AutomationProperties.Name="Paste"
                    ToolTip="Paste an image from the clipboard (Ctrl+V)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77F;"
                               Style="{StaticResource IconStyle}"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Paste" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding OpenImageCommand}"
                    AutomationProperties.Name="Open file"
                    ToolTip="Open an image file (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;"
                               Style="{StaticResource IconStyle}"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Open file" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CaptureCommand}"
                    AutomationProperties.Name="Capture"
                    ToolTip="Select an area of the screen (Ctrl+Shift+S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A8;"
                               Style="{StaticResource IconStyle}"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Capture" />
                </StackPanel>
            </Button>

        </StackPanel>

        <!-- Result card -->
        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status icon: glyph and color follow the scan state -->
                <TextBlock Grid.Column="0"
                           FontSize="20"
                           Margin="0,0,12,0"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource IconStyle}">
                            <Setter Property="Text"
                                    Value="&#xE946;" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static models:ScanState.Success}">
                                    <Setter Property="Text"
                                            Value="&#xE930;" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static models:ScanState.Warning}">
                                    <Setter Property="Text"
                                            Value="&#xE7BA;" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}"
                                             Value="{x:Static models:ScanState.Error}">
                                    <Setter Property="Text"
                                            Value="&#xEA39;" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <ProgressBar IsIndeterminate="True"
                                 Margin="0,8,0,0"
                                 AutomationProperties.Name="Scanning"
                                 Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhenTrue}}" />

                    <!-- Read-only TextBox so the decoded text can be selected -->
                    <TextBox Text="{Binding DecodedText, Mode=OneWay}"
                             Visibility="{Binding DecodedText, Converter={StaticResource VisibleWhenSet}}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             Margin="0,4,0,0"
                             MaxHeight="72"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}">

                        <!-- TextBox handles Ctrl+V itself, so it would swallow the window-level binding -->
                        <TextBox.InputBindings>
                            <KeyBinding Key="V"
                                        Modifiers="Control"
                                        Command="{Binding PasteImageCommand}" />
                        </TextBox.InputBindings>

                    </TextBox>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding Feedback, Converter={StaticResource VisibleWhenSet}}">
                        <TextBlock Text="&#xE73E;"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Feedback}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0">

                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding OpenLinkCommand}"
                            AutomationProperties.Name="Open link"
                            Visibility="{Binding DetectedUrl, Converter={StaticResource VisibleWhenSet}}"
                            ToolTip="Open the link in your browser"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;"
                                       Style="{StaticResource IconStyle}"
                                       FontSize="14"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CopyTextCommand}"
                            AutomationProperties.Name="Copy"
                            Visibility="{Binding DecodedText, Converter={StaticResource VisibleWhenSet}}"
                            ToolTip="Copy the decoded text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;"
                                       Style="{StaticResource IconStyle}"
                                       FontSize="14"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
