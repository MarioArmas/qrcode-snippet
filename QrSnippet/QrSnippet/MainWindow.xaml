<Window x:Class="QrSnippet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Reader"
        Width="600"
        Height="400">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">

            <TextBlock Text="Paste or open an image containing a QR code"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18" />

        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,10">

            <Button Content="Paste Image"
                    Command="{Binding PasteImageCommand}"
                    Width="130"
                    Height="40"
                    Margin="5" />

            <Button Content="Open Image"
                    Width="130"
                    Height="40"
                    Margin="5" />

            <Button Content="Capture"
                    Width="130"
                    Height="40"
                    Margin="5" />

        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   Foreground="Gray" />

    </Grid>

</Window>
