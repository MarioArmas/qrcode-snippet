<Window x:Class="QrSnippet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Reader"
        Width="600"
        Height="400">

    <Window.InputBindings>
        <KeyBinding Key="V"
                    Modifiers="Control"
                    Command="{Binding PasteImageCommand}" />
    </Window.InputBindings>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">

            <TextBlock Text="Paste or open an image containing a QR code"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18" />

        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,10">

            <Button Content="Paste Image"
                    Command="{Binding PasteImageCommand}"
                    Width="130"
                    Height="40"
                    Margin="5" />

            <Button Content="Open Image"
                    Width="130"
                    Height="40"
                    Margin="5" />

            <Button Content="Capture"
                    Width="130"
                    Height="40"
                    Margin="5" />

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <!-- Read-only TextBox styled as a label so the decoded text can be selected -->
            <TextBox Text="{Binding StatusMessage, Mode=OneWay}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="Gray"
                     TextWrapping="Wrap"
                     MaxWidth="420"
                     VerticalAlignment="Center">

                <!-- TextBox handles Ctrl+V itself, so it would swallow the window-level binding -->
                <TextBox.InputBindings>
                    <KeyBinding Key="V"
                                Modifiers="Control"
                                Command="{Binding PasteImageCommand}" />
                </TextBox.InputBindings>

            </TextBox>

            <Button Content="Copy"
                    Command="{Binding CopyTextCommand}"
                    ToolTip="Copy the decoded text"
                    Width="60"
                    Height="24"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />

        </StackPanel>

    </Grid>

</Window>
